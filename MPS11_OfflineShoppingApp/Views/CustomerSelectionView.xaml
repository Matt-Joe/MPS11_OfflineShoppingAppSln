<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView
    x:Class="MPS11_OfflineShoppingApp.Views.CustomerSelectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MPS11_OfflineShoppingApp.Views"
    xmlns:viewModels="clr-namespace:MPS11_OfflineShoppingApp.ViewModels"
    x:TypeArguments="viewModels:CustomerSelectionViewModel"
    Title="Select Customer"
    BackgroundColor="#101010">

    <Grid RowDefinitions="*"
          BackgroundColor="#101010">

        <CollectionView
            ItemsSource="{Binding Customers}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
            BackgroundColor="#101010">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                    <!-- Branding -->
                    <Grid Padding="20,18"
                          BackgroundColor="#181818"
                          ColumnDefinitions="*">

                        <VerticalStackLayout Spacing="0">
                            <Label Text="OFFLINE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#AAAAAA"
                                   CharacterSpacing="3" />

                            <Label Text="STORE."
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   CharacterSpacing="1" />
                        </VerticalStackLayout>

                    </Grid>

                    <!-- Red accent -->
                    <BoxView HeightRequest="3"
                             BackgroundColor="#E10600" />

                    <!-- Welcome section -->
                    <VerticalStackLayout Padding="20,30,20,25"
                                         Spacing="8">

                        <Label Text="RACE DAY STARTS HERE"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#E10600"
                               CharacterSpacing="2" />

                        <Label Text="Who's Driving?"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Select a customer to enter the store and explore performance upgrades."
                               FontSize="14"
                               TextColor="#999999"
                               LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <!-- Customer list heading -->
                    <Grid Padding="20,0,20,15"
                          ColumnDefinitions="*,Auto">

                        <Label Text="SELECT YOUR DRIVER"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White"
                               CharacterSpacing="1" />

                        <Label Grid.Column="1"
                               Text="{Binding Customers.Count, StringFormat='{0} DRIVERS'}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#999999" />

                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Customer cards -->
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border BackgroundColor="#1C1C1C"
                            Stroke="#303030"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="20,0,20,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="48,*,Auto"
                              ColumnSpacing="14">

                            <!-- Driver icon -->
                            <Border BackgroundColor="#303030"
                                    StrokeThickness="0"
                                    HeightRequest="48"
                                    WidthRequest="48"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <Label Text="F1"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#E10600"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Customer details -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="3">

                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White" />

                                <Label Text="{Binding Surname}"
                                       FontSize="13"
                                       TextColor="#999999" />

                            </VerticalStackLayout>

                            <!-- Selection indicator -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="27"
                                   TextColor="#E10600"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty state -->
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30"
                                     Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="NO DRIVERS FOUND"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Label Text="No customers are currently registered."
                           FontSize="13"
                           TextColor="#999999"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="30"
                         BackgroundColor="Transparent" />
            </CollectionView.Footer>

        </CollectionView>

        <!-- Loading indicator -->
        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="#E10600"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</views:BaseView>
