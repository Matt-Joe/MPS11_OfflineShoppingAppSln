<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView
    x:Class="MPS11_OfflineShoppingApp.Views.ProductDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MPS11_OfflineShoppingApp.Views"
    xmlns:viewModels="clr-namespace:MPS11_OfflineShoppingApp.ViewModels"
    x:TypeArguments="viewModels:ProductDetailsViewModel">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="#101010">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid Padding="20,18"
                      BackgroundColor="#181818">

                    <VerticalStackLayout Spacing="0">
                        <Label Text="OFFLINE"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#AAAAAA"
                               CharacterSpacing="3" />

                        <Label Text="STORE."
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="White"
                               CharacterSpacing="1" />
                    </VerticalStackLayout>

                </Grid>

                <BoxView HeightRequest="3"
                         BackgroundColor="#E10600" />

                <!-- Page heading -->
                <VerticalStackLayout Padding="20,25,20,15"
                                     Spacing="5">

                    <Label Text="COMPONENT DETAILS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#E10600"
                           CharacterSpacing="2" />

                    <Label Text="Performance Parts"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White" />

                </VerticalStackLayout>

                <!-- Product visual -->
                <Border Margin="20,0,20,20"
                        HeightRequest="190"
                        BackgroundColor="#242424"
                        Stroke="#303030"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid>
                        <Label Text="F1"
                               FontSize="100"
                               FontAttributes="Bold"
                               TextColor="#303030"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <Label Text="PERFORMANCE COMPONENT"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#E10600"
                               CharacterSpacing="2"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,0,0,18" />
                    </Grid>

                </Border>

                <!-- Product information -->
                <VerticalStackLayout Padding="20,0"
                                     Spacing="10">

                    <Label Text="{Binding CategoryName}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#E10600"
                           CharacterSpacing="1" />

                    <Label Text="{Binding Product.Name}"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="PRODUCT PRICE"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1" />

                    <Label Text="{Binding FormattedPrice}"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#E10600" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="#303030"
                             Margin="0,10" />

                    <!-- Stock information -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="AVAILABLE STOCK"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#AAAAAA"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding Product.Stock}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White" />

                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#303030"
                             Margin="0,10" />

                    <!-- Quantity selector -->
                    <Label Text="SELECT QUANTITY"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#AAAAAA"
                           CharacterSpacing="1" />

                    <Grid ColumnDefinitions="55,65,55"
                          HorizontalOptions="Start"
                          ColumnSpacing="8">

                        <Button Text="−"
                                Command="{Binding DecreaseQuantityCommand}"
                                BackgroundColor="#303030"
                                TextColor="White"
                                FontSize="22"
                                CornerRadius="5"
                                Padding="0"
                                HeightRequest="45" />

                        <Border Grid.Column="1"
                                BackgroundColor="#1C1C1C"
                                Stroke="#303030"
                                StrokeThickness="1"
                                HeightRequest="45">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Label Text="{Binding Quantity}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                        <Button Grid.Column="2"
                                Text="+"
                                Command="{Binding IncreaseQuantityCommand}"
                                BackgroundColor="#303030"
                                TextColor="White"
                                FontSize="22"
                                CornerRadius="5"
                                Padding="0"
                                HeightRequest="45" />

                    </Grid>

                    <!-- Total price -->
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,10,0,20">

                        <Label Text="SUBTOTAL"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#AAAAAA"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding TotalPrice}"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White" />

                    </Grid>

                    <!-- Status message -->
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#E10600"
                           FontSize="12" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#E10600"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Bottom action area -->
        <Grid Grid.Row="1"
              Padding="20,12"
              BackgroundColor="#181818">

            <Button
                Text="ADD TO CART"
                Command="{Binding AddToCartCommand}"
                BackgroundColor="#E10600"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="54" />

            <Label
                Text="{Binding StatusMessage}"
                TextColor="#E10600"
                HorizontalTextAlignment="Center"
                FontSize="13" />

        </Grid>

    </Grid>
</views:BaseView>
