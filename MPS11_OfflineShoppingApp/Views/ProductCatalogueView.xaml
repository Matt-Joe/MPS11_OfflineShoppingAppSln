<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView
    x:Class="MPS11_OfflineShoppingApp.Views.ProductCatalogueView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MPS11_OfflineShoppingApp.Views"
    xmlns:viewModels="clr-namespace:MPS11_OfflineShoppingApp.ViewModels"
    x:TypeArguments="viewModels:ProductCatalogueViewModel"
    Title="Offline Store"
    BackgroundColor="#101010">

    <Grid RowDefinitions="*"
          BackgroundColor="#101010">

        <CollectionView
            ItemsSource="{Binding Products}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
            BackgroundColor="#101010"
            Margin="0">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                    <!-- Top branding bar -->
                    <Grid Padding="20,18"
                          ColumnDefinitions="*,Auto"
                          BackgroundColor="#181818">

                        <VerticalStackLayout Spacing="0">
                            <Label Text="OFFLINE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#AAAAAA"
                                   CharacterSpacing="3" />

                            <Label Text="STORE."
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   CharacterSpacing="1" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#E10600"
                                StrokeThickness="0"
                                Padding="12,7"
                                VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>

                            <Label Text="RACING EDITION"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   CharacterSpacing="1" />
                        </Border>

                    </Grid>

                    <BoxView HeightRequest="3"
                             BackgroundColor="#E10600" />

                    <!-- Customer welcome -->
                    <VerticalStackLayout Padding="20,25,20,20"
                                         Spacing="6">

                        <Label Text="WELCOME BACK"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#E10600"
                               CharacterSpacing="2" />

                        <Label Text="{Binding CustomerName}"
                               FontSize="27"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Your next upgrade starts here."
                               FontSize="14"
                               TextColor="#999999" />

                    </VerticalStackLayout>

                    <!-- Featured banner -->
                    <Grid Margin="20,0,20,25"
                          HeightRequest="145">

                        <Border BackgroundColor="#242424"
                                StrokeThickness="0"
                                Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    VerticalOptions="Center"
                                    Spacing="8">

                                    <Label Text="BUILT FOR"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#AAAAAA"
                                           CharacterSpacing="2" />

                                    <Label Text="THE WIN."
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           CharacterSpacing="1" />

                                    <Label Text="Explore performance upgrades for your machine."
                                           FontSize="12"
                                           TextColor="#CCCCCC"
                                           MaximumWidthRequest="230" />

                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="F1"
                                       FontSize="54"
                                       FontAttributes="Bold"
                                       TextColor="#E10600"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       CharacterSpacing="-3" />

                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Catalogue heading -->
                    <Grid Padding="20,0,20,15"
                          ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="THE COLLECTION"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#E10600"
                                   CharacterSpacing="2" />

                            <Label Text="Performance Upgrades"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="{Binding Products.Count, StringFormat='{0} ITEMS'}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#999999"
                               VerticalOptions="End" />

                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Product cards -->
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border BackgroundColor="#1C1C1C"
                            Stroke="#303030"
                            StrokeThickness="1"
                            Padding="15"
                            Margin="20,0,20,12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="55,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="13"
                              RowSpacing="5">

                            <Border Grid.RowSpan="3"
                                    BackgroundColor="#303030"
                                    StrokeThickness="0"
                                    HeightRequest="55"
                                    WidthRequest="55"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <Label Text="F1"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#E10600"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />

                            <Label Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{Binding CategoryName}"
                                   FontSize="11"
                                   TextColor="#999999" />

                            <Label Grid.Column="1"
                                   Grid.Row="2"
                                   Text="{Binding Stock, StringFormat='STOCK: {0}'}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#BBBBBB" />

                            <Label Grid.Column="2"
                                   Grid.RowSpan="3"
                                   Text="{Binding FormattedPrice}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#E10600"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End" />

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30"
                                     Spacing="10"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="NO UPGRADES AVAILABLE"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Check back later for available products."
                           FontSize="13"
                           TextColor="#999999"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="25"
                         BackgroundColor="Transparent" />
            </CollectionView.Footer>

        </CollectionView>

        <!-- Loading indicator -->
        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="#E10600"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</views:BaseView>
